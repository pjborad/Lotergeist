# openFDA (free key: https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=
# LLM for the Coroner. Leave empty for regex-only mode.
# Option A: Amazon Bedrock (uses the default AWS credential chain)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Option B: Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Which LLM to use: bedrock | anthropic | none (default: auto-detect, else none)
LLM_PROVIDER=none

# Servers
API_PORT=4000
RXTERM_PORT=4100
RXTERM_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:5173
# live = drive RxTerm 98 with Playwright, replay = stream a recorded run
RPA_MODE=live
# fixture = demo heat advisory, nws = real api.weather.gov alerts
WEATHER_MODE=fixture
# OSRM base URL. Empty = straight-line fallback geometry
OSRM_URL=
NWS_USER_AGENT=BodySnatcherRx/0.1 (hackathon demo; contact: you@example.com)
DATA_DIR=./data

# ---- Lotergeist voicemail voice (text-to-speech). Order tried with VOICE_PROVIDER=auto:
# ElevenLabs -> OpenAI -> best neural macOS voice -> the browser's own voice. No voice cloning.
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_turbo_v2_5
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Force a macOS voice, e.g. "Ava (Premium)" after downloading it in System Settings > Accessibility > Spoken Content
MAC_VOICE=
